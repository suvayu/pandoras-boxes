FROM localhost/build-vulkan:latest

COPY ./oneAPI.repo /etc/yum.repos.d/

RUN dnf -y install \
        intel-deep-learning-essentials \
        intel-gpu-firmware \
        intel-level-zero \
        intel-oneapi-toolkit \
        intel-oneapi-dpcpp-ct \
        intel-ocloc-devel \
        python3-jinja2 \
        python3-numpy \
        python3-psutil \
        python3-regex \
	xpu-smi && \
    dnf clean all

RUN ln -s /opt/intel/oneapi/setvars.sh /etc/profile.d/
