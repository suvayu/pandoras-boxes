#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <toolbox-container-name>" >&2
    exit 1
fi

CONTAINER="$1"

# the 'EOF' quoting prevents the outer shell from expanding the heredoc contents
toolbox run -c "$CONTAINER" bash -i -s <<'EOF'
declare HIPCXX="$(hipconfig -l)/clang" HIP_PATH="$(hipconfig -R)"
git pull --rebase
cmake -S . -B build -DGGML_HIP=ON -DGPU_TARGETS=gfx1151 \
      -DGGML_HIP_ROCWMMA_FATTN=1 -DGGML_VULKAN=1 \
      -DBUILD_SHARED_LIBS=1 -DGGML_BACKEND_DL=1 -DGGML_CPU_ALL_VARIANTS=1
cmake --build build
EOF

BUILD_STATUS=$?

if [ "$BUILD_STATUS" -eq 0 ]; then
    podman stop "$CONTAINER"
fi

exit "$BUILD_STATUS"
