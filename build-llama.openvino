#!/bin/bash

declare yr
yr=${ date +%Y; }

[[ -d /opt/intel ]] && source "/opt/intel/openvino_genai_$yr/setupvars.sh"
[[ -d $HOME/intel ]] && source "$HOME/intel/openvino_genai_$yr/setupvars.sh"

cmake -S . -B build \
      -DGGML_OPENVINO=ON \
      -DGGML_VULKAN=1 -DGGML_RPC=ON \
      -DBUILD_SHARED_LIBS=1 -DGGML_BACKEND_DL=1 -DGGML_CPU_ALL_VARIANTS=1
cmake --build build
